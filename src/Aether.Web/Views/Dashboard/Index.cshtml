@model Aether.Web.ViewModels.Dashboard.DashboardViewModel;

<section>
<h1>Your joined Realms</h1>
<div>
    Create a realm here: <a asp-action="CreateRealm" asp-controller="Dashboard">click me</a>
        @if (!Model.Realms.Any())
        {
            <p>You haven't joined any realms yet.</p>
        }
        else
        {
            <ul>
                @foreach (var realm in Model.Realms)
                {
                    <li>
                        <a asp-action="Index" asp-controller="Realm" asp-route-id="@realm.RealmId">@realm.RealmName</a>
                    </li> 
                }
            </ul>
        }
    </div>
</section>