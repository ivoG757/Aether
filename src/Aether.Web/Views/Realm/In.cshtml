@model RealmChatViewModel
@{
    Layout = "_RealmLayout.cshtml";
    ViewData["Title"] = Model.ChannelName ?? "Realm";
}
<header class="chat-header">
    <h1 id="chat-title" aria-live="polite">Realm overview</h1>
    <button type="button" id="toggle-members" aria-controls="realm-members" aria-expanded="false">Members</button>
</header>
<div class="chat-workspace">
    <section class="conversation" aria-labelledby="chat-title">
        <div class="chat-history"><p id="chat-status">No text channel selected.</p></div>
        <div class="composer">
            <input id="message-draft" aria-label="Message" placeholder="Select a text channel" disabled />
        </div>
    </section>
    <aside id="realm-members" aria-labelledby="members-heading" hidden>
        <header>
            <h2 id="members-heading">Members</h2>
            <button type="button" id="close-members" aria-label="Close members panel">×</button>
        </header>
        <p>Member list unavailable.</p>
    </aside>
</div>
@section Scripts {
    <script src="~/js/realm-chat.js" asp-append-version="true"></script>
}